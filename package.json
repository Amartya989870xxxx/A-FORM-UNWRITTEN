{
  "name": "a-form-unwritten",
  "private": true,
  "version": "0.1.0",
  "description": "A Form Unwritten: An atmospheric 2D dark-fantasy adventure vertical slice built with Phaser 3 and TypeScript.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:e2e": "npm run build && node scripts/verify-gameplay.mjs",
    "capture:atmosphere": "node scripts/capture-atmosphere-screenshots.mjs",
    "capture:parity": "node scripts/capture-phase2-parity.mjs",
    "capture:phase3": "npm run build && node scripts/capture-phase3-verification.mjs"
  },
  "dependencies": {
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "playwright-core": "^1.51.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
